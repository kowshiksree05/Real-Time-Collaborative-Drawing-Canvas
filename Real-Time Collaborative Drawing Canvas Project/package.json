{
  "name": "collaborative-canvas",
  "version": "1.0.0",
  "description": "Real-time collaborative drawing canvas application",
  "main": "dist/server/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist/server/server.js",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "npm run build && node dist/server/server.js",
    "dev": "npm run build:client && ts-node-dev --respawn --transpile-only server/server.ts",
    "watch": "npm run build:client && tsc -p tsconfig.server.json --watch"
  },
  "keywords": [
    "canvas",
    "websocket",
    "collaborative",
    "drawing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "@types/uuid": "^9.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}

